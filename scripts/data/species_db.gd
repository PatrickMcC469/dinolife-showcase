func get_species(id: String) -> Dictionary:
	return SPECIES.get(id, {})


func get_all_by_tree(tree: String) -> Array:
	var result = []
	for id in SPECIES:
		if SPECIES[id]["tree"] == tree:
			result.append(id)
	return result


func get_default_unlocked() -> Array:
	var result = []
	for id in SPECIES:
		if SPECIES[id].get("unlocked_by_default", false):
			result.append(id)
	return result
